diff --git a/backend/services/supabase_vendor_bill_service.py b/backend/services/supabase_vendor_bill_service.py
new file mode 100644
index 0000000..6781b72
--- /dev/null
+++ b/backend/services/supabase_vendor_bill_service.py
@@ -0,0 +1,334 @@
+"""Supabase Vendor Bills & Accounts Payable (AP) Synchronization Service.
+
+Mirrors services/supabase_invoice_service.py but for the payable side.
+Handles persistence of Vendor Bills (raw material receipts) and Payments in Supabase:
+- public.financial_entities (Vendors)
+- public.journal_entries & public.journal_lines (Double-Entry Core)
+- public.vendor_bills
+- public.payment_vouchers & public.voucher_allocations
+
+Source-of-truth trigger points (Mongo, backend/routes/vendors.py):
+- receive_vendor_po() -> inserts db.vendor_po_receives -> call sync_vendor_bill_to_supabase()
+- create_vendor_payment() / create_vendor_po_payment() -> call sync_vendor_payment_to_supabase()
+
+Note: Mongo vendor_po_receives carries no GST split (no cgst/sgst/igst fields captured
+at receipt time), so the journal entry below posts the full amount to Raw Material
+Inventory (1040) against Accounts Payable (2010) with no tax lines. If GST fields are
+added to the receipt flow later, extend the journal lines here the same way
+sync_direct_invoice_to_supabase() does for CGST/SGST/IGST.
+"""
+
+import logging
+import uuid
+from datetime import datetime, timezone
+from typing import Dict, Any, Optional, List
+
+from db.supabase_client import get_supabase_admin_client
+from services.supabase_invoice_service import to_uuid, _get_coa_map
+
+log = logging.getLogger(__name__)
+
+
+def ensure_vendor_entity(client, vendor_data: Dict[str, Any], coa_map: Dict[str, str]) -> Optional[str]:
+    """Ensure vendor exists in public.financial_entities with GL Account 2010 (Accounts Payable)."""
+    gl_ap = coa_map.get("2010")
+    if not gl_ap:
+        log.warning("GL Account 2010 (Accounts Payable) not found in chart_of_accounts.")
+        return None
+
+    vendor_id_val = vendor_data.get("id") or vendor_data.get("_id") or vendor_data.get("vendor_id")
+    if not vendor_id_val:
+        name_clean = (vendor_data.get("name") or vendor_data.get("vendor_name") or "VENDOR").strip()
+        vendor_uuid = str(uuid.uuid5(uuid.NAMESPACE_OID, f"VENDOR_{name_clean}"))
+    else:
+        vendor_uuid = to_uuid(vendor_id_val)
+
+    name = (vendor_data.get("name") or vendor_data.get("vendor_name") or "Vendor").strip()
+    code = (vendor_data.get("code") or f"VEN-{name[:4].upper()}-{vendor_uuid[:4].upper()}").strip()
+
+    row = {
+        "id": vendor_uuid,
+        "entity_type": "VENDOR",
+        "external_ref_id": str(vendor_id_val or vendor_uuid),
+        "code": code,
+        "name": name,
+        "gstin": vendor_data.get("gstin") or "",
+        "pan": vendor_data.get("pan") or "",
+        "phone": vendor_data.get("phone") or "",
+        "email": vendor_data.get("email") or "",
+        "billing_address": str(vendor_data.get("address") or ""),
+        "payment_terms_days": int(vendor_data.get("payment_terms_days") or 30),
+        "gl_account_id": gl_ap,
+        "is_active": bool(vendor_data.get("active", True)),
+    }
+
+    try:
+        client.table("financial_entities").upsert(row, on_conflict="id").execute()
+        return vendor_uuid
+    except Exception as e:
+        log.error("Failed to upsert vendor entity %s in Supabase: %s", vendor_uuid, e)
+        return None
+
+
+def sync_vendor_bill_to_supabase(receive_doc: Dict[str, Any], vendor_doc: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    """
+    Persist a vendor PO receipt (Mongo: vendor_po_receives) as a Vendor Bill in Supabase:
+    1. Ensures Vendor in public.financial_entities.
+    2. Creates balanced public.journal_entries (Debit Raw Material Inventory 1040 = Credit AP 2010).
+    3. Creates public.journal_lines.
+    4. Creates public.vendor_bills record.
+    """
+    client = get_supabase_admin_client()
+    if not client:
+        log.warning("Supabase admin client unavailable; skipping vendor bill sync.")
+        return None
+
+    try:
+        coa_map = _get_coa_map(client)
+        if not coa_map:
+            log.warning("No chart of accounts found in Supabase.")
+            return None
+
+        gl_ap = coa_map.get("2010")          # Accounts Payable (Raw Material Suppliers)
+        gl_inventory = coa_map.get("1040")   # Raw Material Inventory Asset
+
+        if not gl_ap or not gl_inventory:
+            log.error("Core GL accounts (2010 or 1040) missing in Supabase.")
+            return None
+
+        vendor_uuid = ensure_vendor_entity(client, vendor_doc, coa_map)
+        if not vendor_uuid:
+            log.error("Could not link/create vendor entity in Supabase.")
+            return None
+
+        raw_bill_id = str(receive_doc.get("_id") or receive_doc.get("id") or uuid.uuid4())
+        bill_uuid = to_uuid(raw_bill_id)
+        receipt_id = receive_doc.get("receipt_id") or raw_bill_id[:8]
+        po_number = receive_doc.get("po_number") or "PO"
+        bill_no = f"BILL-{po_number}-{receipt_id}".replace("/", "-")
+
+        total_amount = round(float(receive_doc.get("total_amount") or 0.0), 2)
+        if total_amount <= 0:
+            log.info("Skipping vendor bill sync for zero-amount receipt %s.", receipt_id)
+            return None
+
+        bill_date = str(receive_doc.get("receipt_date") or datetime.now(timezone.utc).date().isoformat())[:10]
+        vendor_terms_days = int(vendor_doc.get("payment_terms_days") or 30)
+        due_date = bill_date  # Mongo receive_doc has no due date field; downstream can recompute if needed.
+
+        je_id = str(uuid.uuid5(uuid.NAMESPACE_OID, f"JE_BILL_{bill_uuid}"))
+        vendor_name = vendor_doc.get("name") or "Vendor"
+        narration = f"Vendor Bill {bill_no} from {vendor_name} (PO {po_number})"
+
+        je_row = {
+            "id": je_id,
+            "entry_number": f"JE-BILL-{bill_no}",
+            "entry_date": bill_date,
+            "entry_type": "VENDOR_BILL",
+            "status": "POSTED",
+            "narration": narration,
+            "source_document_ref": bill_no,
+            "total_debit": total_amount,
+            "total_credit": total_amount,
+            "posted_by": receive_doc.get("by") or "system",
+            "posted_at": datetime.now(timezone.utc).isoformat(),
+        }
+        client.table("journal_entries").upsert(je_row, on_conflict="id").execute()
+
+        lines: List[Dict[str, Any]] = [
+            # Debit Raw Material Inventory
+            {
+                "id": str(uuid.uuid5(uuid.NAMESPACE_OID, f"{je_id}_line_inv")),
+                "journal_entry_id": je_id,
+                "account_id": gl_inventory,
+                "entity_id": vendor_uuid,
+                "line_number": 1,
+                "description": f"Materials received: {bill_no}",
+                "debit": total_amount,
+                "credit": 0.0,
+                "reconciliation_status": "RECONCILED",
+            },
+            # Credit Accounts Payable
+            {
+                "id": str(uuid.uuid5(uuid.NAMESPACE_OID, f"{je_id}_line_ap")),
+                "journal_entry_id": je_id,
+                "account_id": gl_ap,
+                "entity_id": vendor_uuid,
+                "line_number": 2,
+                "description": f"Payable: {bill_no}",
+                "debit": 0.0,
+                "credit": total_amount,
+                "reconciliation_status": "UNRECONCILED",
+            },
+        ]
+        client.table("journal_lines").upsert(lines, on_conflict="id").execute()
+
+        bill_row = {
+            "id": bill_uuid,
+            "bill_no": bill_no,
+            "vendor_id": vendor_uuid,
+            "vendor_po_ref": po_number,
+            "bill_date": bill_date,
+            "due_date": due_date,
+            "subtotal": total_amount,
+            "cgst_amount": 0.0,
+            "sgst_amount": 0.0,
+            "igst_amount": 0.0,
+            "total_amount": total_amount,
+            "paid_amount": 0.0,
+            "status": "POSTED",
+            "journal_entry_id": je_id,
+        }
+        res_bill = client.table("vendor_bills").upsert(bill_row, on_conflict="id").execute()
+        log.info("Successfully synced Vendor Bill %s (%s) to Supabase.", bill_no, bill_uuid)
+        return res_bill.data[0] if (res_bill and getattr(res_bill, "data", None)) else bill_row
+
+    except Exception as e:
+        log.error("Failed to sync vendor bill to Supabase: %s", e)
+        return None
+
+
+def sync_vendor_payment_to_supabase(payment_doc: Dict[str, Any], vendor_doc: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    """
+    Persist a payment made to a vendor into Supabase:
+    1. Debit Accounts Payable, Credit Bank/Cash.
+    2. Creates public.payment_vouchers record (voucher_type='PAYMENT').
+    3. Creates public.voucher_allocations if the payment references specific bills.
+    Note: Mongo PaymentIn has no per-bill allocation map today (unlike client receipts) —
+    allocations are only written if payment_doc includes one (e.g. added later).
+    """
+    client = get_supabase_admin_client()
+    if not client:
+        return None
+
+    try:
+        coa_map = _get_coa_map(client)
+        if not coa_map:
+            return None
+
+        gl_ap = coa_map.get("2010")
+        gl_cash = coa_map.get("1020-FACTORY-CASH") or coa_map.get("1020")
+        gl_bank = coa_map.get("1010")
+
+        if not gl_ap:
+            return None
+
+        amount = round(float(payment_doc.get("amount") or 0.0), 2)
+        if amount <= 0:
+            return None
+
+        mode = (payment_doc.get("mode") or "Bank Transfer").upper()
+        is_cash = ("CASH" in mode) and not payment_doc.get("bank_account_id")
+        credit_gl = gl_cash if is_cash else gl_bank
+
+        pay_id = to_uuid(payment_doc.get("_id") or payment_doc.get("id"))
+        pay_date = str(payment_doc.get("payment_date") or datetime.now(timezone.utc).date().isoformat())[:10]
+        payment_no = payment_doc.get("payment_no") or f"PAY-{pay_id[:8].upper()}"
+
+        vendor_uuid = ensure_vendor_entity(client, vendor_doc, coa_map)
+        if not vendor_uuid:
+            return None
+
+        je_id = str(uuid.uuid5(uuid.NAMESPACE_OID, f"JE_PAY_{pay_id}"))
+        vendor_name = vendor_doc.get("name") or "Vendor"
+        narration = f"Payment {payment_no} to {vendor_name}"
+
+        je_row = {
+            "id": je_id,
+            "entry_number": f"JE-PAY-{payment_no.replace('/', '-')}",
+            "entry_date": pay_date,
+            "entry_type": "PAYMENT",
+            "status": "POSTED",
+            "narration": narration,
+            "source_document_ref": payment_no,
+            "total_debit": amount,
+            "total_credit": amount,
+            "posted_by": payment_doc.get("by") or "system",
+            "posted_at": datetime.now(timezone.utc).isoformat(),
+        }
+        client.table("journal_entries").upsert(je_row, on_conflict="id").execute()
+
+        lines = [
+            # Debit Accounts Payable
+            {
+                "id": str(uuid.uuid5(uuid.NAMESPACE_OID, f"{je_id}_line_dr")),
+                "journal_entry_id": je_id,
+                "account_id": gl_ap,
+                "entity_id": vendor_uuid,
+                "line_number": 1,
+                "description": f"Payment against bills from {vendor_name}",
+                "debit": amount,
+                "credit": 0.0,
+                "reconciliation_status": "RECONCILED",
+            },
+            # Credit Cash / Bank
+            {
+                "id": str(uuid.uuid5(uuid.NAMESPACE_OID, f"{je_id}_line_cr")),
+                "journal_entry_id": je_id,
+                "account_id": credit_gl,
+                "entity_id": vendor_uuid,
+                "line_number": 2,
+                "description": f"Payment via {mode}",
+                "debit": 0.0,
+                "credit": amount,
+                "reconciliation_status": "UNRECONCILED" if not is_cash else "RECONCILED",
+            },
+        ]
+        client.table("journal_lines").upsert(lines, on_conflict="id").execute()
+
+        voucher_id = str(uuid.uuid5(uuid.NAMESPACE_OID, f"VCH_PAY_{pay_id}"))
+        bank_acc_uuid = to_uuid(payment_doc.get("bank_account_id")) if payment_doc.get("bank_account_id") else None
+
+        voucher_row = {
+            "id": voucher_id,
+            "voucher_no": f"VCH-PAY-{payment_no}",
+            "voucher_type": "PAYMENT",
+            "voucher_date": pay_date,
+            "entity_id": vendor_uuid,
+            "payment_mode": "CASH" if is_cash else "BANK_TRANSFER",
+            "bank_account_id": bank_acc_uuid,
+            "amount": amount,
+            "reference_number": payment_doc.get("reference") or "",
+            "journal_entry_id": je_id,
+            "notes": narration,
+        }
+        res_vch = client.table("payment_vouchers").upsert(voucher_row, on_conflict="id").execute()
+
+        # Optional per-bill allocations, and vendor_bills.paid_amount update, if a PO reference
+        # (single-bill payment) is present. PaymentIn carries vendor_po_id (Mongo ObjectId), but
+        # vendor_bills.vendor_po_ref stores the human-readable po_number — use that, not the id.
+        vendor_po_ref = payment_doc.get("vendor_po_number") or payment_doc.get("vendor_po_ref")
+        if vendor_po_ref:
+            try:
+                cur_bill = (
+                    client.table("vendor_bills")
+                    .select("id, total_amount, paid_amount")
+                    .eq("vendor_po_ref", vendor_po_ref)
+                    .order("bill_date", desc=True)
+                    .execute()
+                )
+                if cur_bill.data:
+                    b = cur_bill.data[0]
+                    bt = float(b.get("total_amount") or 0.0)
+                    old_paid = float(b.get("paid_amount") or 0.0)
+                    new_paid = round(min(bt, old_paid + amount), 2)
+                    new_status = "PAID" if new_paid >= bt - 0.01 else "PARTIALLY_PAID"
+                    client.table("vendor_bills").update({
+                        "paid_amount": new_paid,
+                        "status": new_status,
+                    }).eq("id", b["id"]).execute()
+                    client.table("voucher_allocations").upsert({
+                        "id": str(uuid.uuid5(uuid.NAMESPACE_OID, f"{voucher_id}_{b['id']}")),
+                        "voucher_id": voucher_id,
+                        "vendor_bill_id": b["id"],
+                        "allocated_amount": amount,
+                    }, on_conflict="id").execute()
+            except Exception as ie:
+                log.debug("Could not update vendor_bill for PO %s in Supabase: %s", vendor_po_ref, ie)
+
+        log.info("Successfully recorded payment voucher %s into Supabase.", voucher_id)
+        return res_vch.data[0] if (res_vch and getattr(res_vch, "data", None)) else voucher_row
+
+    except Exception as e:
+        log.error("Failed to sync vendor payment to Supabase: %s", e)
+        return None
